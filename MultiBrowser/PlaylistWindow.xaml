<Window x:Class="MultiBrowser.PlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý Kịch Bản Xem Lần Lượt - MultiBrowser" Height="680" Width="1050"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#121214" Foreground="#F4F4F5">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content (2 Columns: Add Form + Playlist Table) -->
            <RowDefinition Height="*"/>
            <!-- Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,10" BorderBrush="#27272A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🎬 KỊCH BẢN XEM LẦN LƯỢT ĐA NỀN TẢNG" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Tự động nhận diện YouTube Shorts, YouTube Video Dài, TikTok, FB Reels/Video, Insta Reels; xem lần lượt từ link này sang link khác" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📂 Nạp Mẫu Mặc Định" Click="BtnLoadDefault_Click"
                            Padding="10,5" Margin="0,0,8,0" Background="#27272A" Foreground="#D1D5DB" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                    <Button Content="💾 Lưu Kịch Bản" Click="BtnSaveConfig_Click"
                            Padding="10,5" Background="#1E3A8A" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Form thêm bước (Width 380) -->
                <ColumnDefinition Width="380"/>
                <!-- Danh sách kịch bản (Width *) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Form Thêm Link Vào Kịch Bản -->
            <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="➕ THÊM MỤC TIÊU VÀO KỊCH BẢN" Style="{StaticResource SectionTitle}"/>

                        <!-- URL Input -->
                        <TextBlock Text="Đường dẫn liên kết (URL):" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="TxtUrl" Style="{StaticResource InputBox}" 
                                 Text="https://www.youtube.com/@lam-kid-studio/shorts"
                                 TextChanged="TxtUrl_TextChanged"/>

                        <!-- Platform auto-detection badge -->
                        <Border x:Name="BadgePlatform" Background="#1E3A8A" CornerRadius="4" Padding="6,3" Margin="0,4,0,8" HorizontalAlignment="Left">
                            <TextBlock x:Name="TxtPlatformDetected" Text="🔴 Đã nhận diện: YouTube Shorts" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>

                        <!-- Title/Ghi chú -->
                        <TextBlock Text="Tên / Ghi chú mục tiêu:" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="TxtTitle" Style="{StaticResource InputBox}" Text="Kênh Shorts 1" Margin="0,0,0,8"/>

                        <!-- Chọn nền tảng (nếu muốn chỉnh tay) -->
                        <TextBlock Text="Nền tảng thực thi:" Style="{StaticResource LabelText}"/>
                        <ComboBox x:Name="CmbPlatform" Height="26" FontSize="11" Background="#27272A" Foreground="Black" Margin="0,0,0,8">
                            <ComboBoxItem Content="🔴 YouTube Shorts"/>
                            <ComboBoxItem Content="📺 YouTube Video Dài (Master)"/>
                            <ComboBoxItem Content="🎵 TikTok"/>
                            <ComboBoxItem Content="📘 Facebook Reels"/>
                            <ComboBoxItem Content="📘 Facebook Video Dài"/>
                            <ComboBoxItem Content="📷 Instagram Reels"/>
                            <ComboBoxItem Content="🌐 Liên kết Web Khác"/>
                        </ComboBox>

                        <!-- Chiến lược cuộn video -->
                        <TextBlock Text="Chiến lược cuộn / Hướng xem:" Style="{StaticResource LabelText}"/>
                        <StackPanel Margin="0,0,0,8">
                            <RadioButton x:Name="RbTopToBottom" Content="⬇️ Lướt từ trên xuống (Mới nhất ➔ Cũ)" IsChecked="True" Foreground="#E4E4E7" FontSize="11" Margin="0,2" Cursor="Hand"/>
                            <RadioButton x:Name="RbBottomToTop" Content="⬆️ Cuộn xuống đáy rồi lướt lên (Cũ nhất ➔ Mới)" Foreground="#E4E4E7" FontSize="11" Margin="0,2" Cursor="Hand"/>
                        </StackPanel>

                        <!-- Chế độ thời lượng xem -->
                        <TextBlock Text="Chế độ thời lượng xem mỗi video:" Style="{StaticResource LabelText}"/>
                        <StackPanel Margin="0,0,0,8">
                            <RadioButton x:Name="RbFullDuration" Content="⏱️ Xem hết video (Đo thời lượng thực tế duration)" IsChecked="True" Foreground="#34D399" FontWeight="SemiBold" FontSize="11" Margin="0,2" Cursor="Hand"/>
                            <RadioButton x:Name="RbFixedDuration" Content="⌛ Xem cố định X giây" Foreground="#E4E4E7" FontSize="11" Margin="0,2" Cursor="Hand"/>
                            <RadioButton x:Name="RbRandomDuration" Content="🎲 Xem ngẫu nhiên (Min - Max giây)" Foreground="#E4E4E7" FontSize="11" Margin="0,2" Cursor="Hand"/>
                        </StackPanel>

                        <!-- Input số giây -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Giây cố định / Min:" FontSize="10" Foreground="#9CA3AF"/>
                                <TextBox x:Name="TxtSecFixed" Text="15" Style="{StaticResource InputBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Giây Max:" FontSize="10" Foreground="#9CA3AF"/>
                                <TextBox x:Name="TxtSecMax" Text="30" Style="{StaticResource InputBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Số video cần xem trước khi chuyển link -->
                        <TextBlock Text="Số video xem ở link này trước khi next link:" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="TxtVideoCount" Text="5" Style="{StaticResource InputBox}" Margin="0,0,0,8"/>

                        <!-- Options: Tương tác -->
                        <CheckBox x:Name="ChkAutoLike" Content="❤️ Tự động thả tym / thích video nếu chưa like" IsChecked="True"
                                  Foreground="#F472B6" FontWeight="SemiBold" FontSize="11" Margin="0,2,0,4" Cursor="Hand"/>
                        <CheckBox x:Name="ChkAutoInteract" Content="🔗 Mô phỏng tương tác (Hover nút share)" IsChecked="False"
                                  Foreground="#A1A1AA" FontSize="10" Margin="0,0,0,12" Cursor="Hand"/>

                        <!-- Nút Thêm -->
                        <Button Content="➕ Thêm Bước Này Vào Kịch Bản" Click="BtnAddStep_Click"
                                Padding="12,8" Background="#2563EB" Foreground="White" BorderThickness="0" 
                                FontWeight="Bold" FontSize="12" Cursor="Hand"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 2. Bảng Danh Sách Các Bước Trong Kịch Bản -->
            <Border Grid.Column="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Danh sách header & công cụ điều khiển thứ tự -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📋 THỨ TỰ THỰC THI LẦN LƯỢT" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="⬆️ Lên" Click="BtnMoveUp_Click" Padding="8,3" Margin="0,0,4,0" Background="#27272A" Foreground="#FAFAFA" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                            <Button Content="⬇️ Xuống" Click="BtnMoveDown_Click" Padding="8,3" Margin="0,0,4,0" Background="#27272A" Foreground="#FAFAFA" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                            <Button Content="🗑️ Xóa" Click="BtnDeleteStep_Click" Padding="8,3" Margin="0,0,4,0" Background="#7F1D1D" Foreground="White" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                            <Button Content="🧹 Xóa hết" Click="BtnClearAll_Click" Padding="8,3" Background="#3F3F46" Foreground="#FAFAFA" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <!-- DataGrid / ListBox hiển thị các bước -->
                    <DataGrid x:Name="DgPlaylist" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="#121214" Foreground="#E4E4E7" RowBackground="#18181B" AlternatingRowBackground="#202026"
                              BorderBrush="#27272A" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#27272A"
                              HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nền Tảng" Binding="{Binding PlatformBadge}" Width="100" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Ghi Chú / Tên" Binding="{Binding Title}" Width="120"/>
                            <DataGridTextColumn Header="Đường Dẫn (URL)" Binding="{Binding Url}" Width="200"/>
                            <DataGridTextColumn Header="Chiến Lược Cuộn" Binding="{Binding StrategyDescription}" Width="150"/>
                            <DataGridTextColumn Header="Thời Lượng Xem" Binding="{Binding DurationDescription}" Width="160"/>
                            <DataGridTextColumn Header="Số Video" Binding="{Binding VideoCount}" Width="60"/>
                            <DataGridCheckBoxColumn Header="Thả Tym" Binding="{Binding AutoLike}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Cấu hình chạy vòng lặp -->
                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="0,8,0,0" BorderBrush="#27272A" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkLoopContinuous" Grid.Column="0" Content="🔁 Lặp lại kịch bản liên tục khi chạy xong hết danh sách"
                                      IsChecked="True" Foreground="#60A5FA" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Cursor="Hand"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Nghỉ giữa các link:" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="TxtDelayBetweenLinks" Text="3" Width="30" Height="22" Style="{StaticResource InputBox}" TextAlignment="Center"/>
                                <TextBlock Text="giây" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Padding="0,12,0,0" Margin="0,10,0,0" BorderBrush="#27272A" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Sẵn sàng cấu hình kịch bản" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Đóng" Click="BtnClose_Click"
                            Padding="16,8" Margin="0,0,8,0" Background="#27272A" Foreground="#E4E4E7" BorderThickness="0" 
                            FontWeight="Medium" FontSize="12" Cursor="Hand"/>
                    <Button x:Name="BtnStartPlaylistNow" Content="▶ BẮT ĐẦU CHẠY KỊCH BẢN NÀY NGAY" Click="BtnStartPlaylistNow_Click"
                            Padding="18,8" Background="#DB2777" Foreground="White" BorderThickness="0" 
                            FontWeight="Bold" FontSize="12" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
