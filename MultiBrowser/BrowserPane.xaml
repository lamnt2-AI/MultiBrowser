<UserControl x:Class="MultiBrowser.BrowserPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="600">
    
    <UserControl.Resources>
        <Style x:Key="MiniTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="#27272A" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}" BorderBrush="#3F3F46" BorderThickness="1,1,1,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F46"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="6,0,2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="#27272A" CornerRadius="4" Padding="{TemplateBinding Padding}" BorderBrush="#4B5563" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7C3AED"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#1E1E24">
        <Grid.RowDefinitions>
            <!-- Tab Strip bar -->
            <RowDefinition Height="Auto"/>
            <!-- Header bar with Navigation & URL -->
            <RowDefinition Height="Auto"/>
            <!-- Loading progress bar -->
            <RowDefinition Height="Auto"/>
            <!-- Content Grid with WebView2 controls -->
            <RowDefinition Height="*"/>
            <!-- Status footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Tab Strip Bar -->
        <Border Grid.Row="0" Background="#18181B" Padding="6,4,6,0" BorderBrush="#27272A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Profile Badge -->
                <Border Grid.Column="0" Background="#3B82F6" CornerRadius="4" Padding="6,2" Margin="0,0,8,4" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtProfileBadge" Text="Profile 1" Foreground="White" FontWeight="Bold" FontSize="11"/>
                </Border>

                <!-- Tab Selectors -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <RadioButton x:Name="RbTab1" Content="🔴 Tab 1 (YouTube)" IsChecked="True" Style="{StaticResource MiniTabStyle}" Click="RbTab1_Click"/>
                    <RadioButton x:Name="RbTab2" Content="🎵 Tab 2 (TikTok)" Style="{StaticResource MiniTabStyle}" Click="RbTab2_Click"/>
                    <ToggleButton x:Name="BtnSplitTab" Content="🪟 Chia Dọc" ToolTip="Chia đôi ô theo chiều dọc: Bên trái YouTube, Bên phải TikTok" 
                                  Style="{StaticResource MiniToggleStyle}" Click="BtnSplitTab_Click"/>
                </StackPanel>

                <!-- Quick Preset switchers -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <Button Content="🎵 TikTok" ToolTip="Mở TikTok trên tab đang chọn" Click="BtnQuickTikTok_Click" 
                            Padding="5,1" Height="22" Margin="1,0" Background="#000000" Foreground="#25F4EE" BorderBrush="#FE2C55" BorderThickness="1" FontSize="10" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="📺 YouTube" ToolTip="Mở YouTube trên tab đang chọn" Click="BtnYoutube_Click" 
                            Padding="5,1" Height="22" Margin="1,0" Background="#7F1D1D" Foreground="White" BorderThickness="0" FontSize="10" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Header Controls (Back, Forward, Reload, URL) -->
        <Border Grid.Row="1" Background="#282830" Padding="6,4" BorderBrush="#383842" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Nav buttons -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- URL bar -->
                    <ColumnDefinition Width="*"/>
                    <!-- Quick actions -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0">
                    <Button x:Name="BtnBack" Content="◀" ToolTip="Quay lại (Back)" Click="BtnBack_Click" 
                            Width="26" Height="24" Margin="1,0" Background="#33333D" Foreground="#E0E0E0" BorderBrush="#444452" Cursor="Hand"/>
                    <Button x:Name="BtnForward" Content="▶" ToolTip="Tiến tới (Forward)" Click="BtnForward_Click" 
                            Width="26" Height="24" Margin="1,0" Background="#33333D" Foreground="#E0E0E0" BorderBrush="#444452" Cursor="Hand"/>
                    <Button x:Name="BtnReload" Content="🔄" ToolTip="Tải lại (Reload)" Click="BtnReload_Click" 
                            Width="26" Height="24" Margin="1,0" Background="#33333D" Foreground="#E0E0E0" BorderBrush="#444452" Cursor="Hand"/>
                    <Button x:Name="BtnHome" Content="🏠" ToolTip="Trang Google Account" Click="BtnHome_Click" 
                            Width="26" Height="24" Margin="1,0" Background="#33333D" Foreground="#E0E0E0" BorderBrush="#444452" Cursor="Hand"/>
                </StackPanel>

                <!-- URL Bar -->
                <Grid Grid.Column="1" Margin="0,0,6,0">
                    <TextBox x:Name="TxtUrl" Background="#18181B" Foreground="#F4F4F5" BorderBrush="#3F3F46" 
                             VerticalContentAlignment="Center" Padding="8,2" FontSize="12" KeyDown="TxtUrl_KeyDown"
                             GotFocus="TxtUrl_GotFocus"/>
                    <Button x:Name="BtnGo" Content="➔" HorizontalAlignment="Right" Width="26" Height="22" Margin="0,0,1,0"
                            Background="Transparent" Foreground="#A1A1AA" BorderThickness="0" Cursor="Hand" Click="BtnGo_Click"/>
                </Grid>

                <!-- Quick Services Menu -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="G Login" ToolTip="Đăng nhập Google" Click="BtnGoogleLogin_Click"
                            Padding="6,2" Height="24" Margin="1,0" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Medium" FontSize="11" Cursor="Hand"/>
                    <Button Content="Gmail" ToolTip="Mở Gmail" Click="BtnGmail_Click"
                            Padding="6,2" Height="24" Margin="1,0" Background="#DC2626" Foreground="White" BorderThickness="0" FontWeight="Medium" FontSize="11" Cursor="Hand"/>
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="2,0,0,0">
                        <MenuItem Header="⋮" Foreground="#A1A1AA" FontSize="14" FontWeight="Bold" Padding="4,2">
                            <MenuItem Header="Cài đặt Proxy (proxy.txt)" Click="MenuSetProxy_Click"/>
                            <Separator/>
                            <MenuItem Header="Xóa Cookie / Cache (Đăng xuất)" Click="MenuClearData_Click"/>
                            <MenuItem Header="Mở thư mục Profile này" Click="MenuOpenFolder_Click"/>
                            <Separator/>
                            <MenuItem Header="Google Drive" Click="MenuGoogleDrive_Click"/>
                            <MenuItem Header="Google Docs" Click="MenuGoogleDocs_Click"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Progress Bar -->
        <ProgressBar x:Name="LoadingBar" Grid.Row="2" Height="2" IsIndeterminate="True" 
                     Visibility="Collapsed" Foreground="#3B82F6" Background="Transparent" BorderThickness="0"/>

        <!-- 4. Browser Content (Supporting 2 Tabs or Split View) -->
        <Grid x:Name="TabContainer" Grid.Row="3" Background="#121214">
            <!-- Tab 1 WebView (Default YouTube) -->
            <Border x:Name="WrapperTab1" BorderBrush="#2563EB" BorderThickness="0">
                <wv2:WebView2 x:Name="BrowserControl1" Visibility="Visible" />
            </Border>

            <!-- Tab 2 WebView (Default TikTok) -->
            <Border x:Name="WrapperTab2" BorderBrush="#7C3AED" BorderThickness="0">
                <wv2:WebView2 x:Name="BrowserControl2" Visibility="Collapsed" />
            </Border>

            <!-- Placeholder overlay during init -->
            <Border x:Name="LoadingOverlay" Background="#121214" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtInitStatus" Text="Đang khởi tạo các tab riêng biệt..." Foreground="#A1A1AA" FontSize="13" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Width="140" Height="3" Margin="0,10,0,0" Foreground="#3B82F6"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 5. Mini Status Footer -->
        <Border Grid.Row="4" Background="#18181B" Padding="8,2" BorderBrush="#27272A" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtActiveTabIndicator" Grid.Column="0" Text="[Tab 1]" Foreground="#3B82F6" FontWeight="Bold" FontSize="10" Margin="0,0,6,0"/>
                <TextBlock x:Name="TxtStatus" Grid.Column="1" Text="Sẵn sàng" Foreground="#71717A" FontSize="10" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
